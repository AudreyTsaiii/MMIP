    <node id="Stability AI">
      <data key="d0">Organization</data>
      <data key="d1">Provided compute for training and evaluating the models.</data>
      <data key="d2">0</data>
    </node>
    <node id="Large Language Models">
      <data key="d0">Concept</data>
      <data key="d1">Models that often produce factual errors because they rely only on parametric knowledge.</data>
      <data key="d2">6</data>
    </node>
    <node id="Retrieval-Augmented Generation">
      <data key="d0">Method</data>
      <data key="d1">RAG method proposed by Lewis et al. (2020) and Guu et al. (2020) that reduces factual errors.</data>
      <data key="d2">7</data>
    </node>
    <node id="Conventional RAG">
      <data key="d0">Method</data>
      <data key="d1">Retrieval-Augmented Generation that retrieves a fixed number of passages indiscriminately.</data>
      <data key="d2">8</data>
    </node>
    <node id="LM">
      <data key="d0">Model</data>
      <data key="d1">Language model used for generation and retrieval tasks.</data>
      <data key="d2">0</data>
    </node>
    <node id="reflection token">
      <data key="d0">Token</data>
      <data key="d1">Special tokens generated by the LM divided into retrieval tokens and critique tokens. | 加入模型詞彙表中的反射標記 | 被加入詞彙表中並由生成器自行生成的反思 token。</data>
      <data key="d2">2</data>
    </node>
    <node id="Retrieve">
      <data key="d0">Token</data>
      <data key="d1">One of the reflection tokens whose output values are yes. | 決定何時調用檢索器的反射 token，輸出為 yes、no 或 continue | Reflection token type that asks whether finding external documents from the web helps to generate a better response.</data>
      <data key="d2">2</data>
    </node>
    <node id="IsRel">
      <data key="d0">Token</data>
      <data key="d1">判斷段落是否提供有用資訊的批判 token，輸出為 relevant 或 irrelevant | 預測是否相關的反射標記 | Reflection token predicted by the critic for each passage. | 具有特定類型的評論 token。</data>
      <data key="d2">2</data>
    </node>
    <node id="IsSup">
      <data key="d0">Token</data>
      <data key="d1">判斷陳述是否受段落支援的批判 token，輸出為 fully supported、partially supported 或 no support | 預測支持程度的反射標記 | Reflection token predicted by the critic for relevant passages. | 具有特定類型的評論 token，其較高的權重可強調證據支援。 | 用于判断支持程度的标记</data>
      <data key="d2">2</data>
    </node>
    <node id="IsUse">
      <data key="d0">Token</data>
      <data key="d1">判斷回應是否為有用回應的批判 token，輸出為 5、4、3、2 或 1 | 預測有用程度的反射標記 | Reflection token predicted by the critic at the end of the output. | 具有特定類型的評論 token。</data>
      <data key="d2">2</data>
    </node>
    <node id="M">
      <data key="d0">Model</data>
      <data key="d1">生成器模型，負責預測 token 與生成文本段落 | Self-RAG 的生成器模型</data>
      <data key="d2">2</data>
    </node>
    <node id="R">
      <data key="d0">Model</data>
      <data key="d1">檢索器模型，負責檢索相關段落</data>
      <data key="d2">9</data>
    </node>
    <node id="Algorithm 1">
      <data key="d0">Method</data>
      <data key="d1">推論程序演算法</data>
      <data key="d2">10</data>
    </node>
    <node id="C">
      <data key="d0">Model</data>
      <data key="d1">Self-RAG 的批評者模型</data>
      <data key="d2">2</data>
    </node>
    <node id="PPO">
      <data key="d0">Method</data>
      <data key="d1">用於 RLHF 的強化學習方法 | 基於近端策略最佳化的人類回饋強化學習方法</data>
      <data key="d2">0</data>
    </node>
    <node id="RLHF">
      <data key="d0">Method</data>
      <data key="d1">基於人類回饋的強化學習</data>
      <data key="d2">11</data>
    </node>
    <node id="GPT-4">
      <data key="d0">Model</data>
      <data key="d1">用於生成反射標記的專有語言模型 | Used to prompt with type-specific instructions and few-shot demonstrations for reflection token types.</data>
      <data key="d2">2</data>
    </node>
    <node id="Llama2-7B">
      <data key="d0">Model</data>
      <data key="d1">Pre-trained language model used to initialise the critic C, serving as the same base as the generator.</data>
      <data key="d2">2</data>
    </node>
    <node id="Critic C">
      <data key="d0">Model</data>
      <data key="d1">Initialised from Llama 2-7B and trained to decide reflection tokens and predict IsRel, IsSup, and IsUse.</data>
      <data key="d2">2</data>
    </node>
    <node id="Retriever R">
      <data key="d0">Model</data>
      <data key="d1">Retrieves the top K passages when the Retrieve=Yes token is inserted.</data>
      <data key="d2">12</data>
    </node>
    <node id="Generator M">
      <data key="d0">Model</data>
      <data key="d1">Trained with the standard next-token objective to predict both the target output and the reflection tokens. | 被訓練以預測目標輸出與反思 token 的生成器模型。</data>
      <data key="d2">3</data>
    </node>
    <node id="D_gen">
      <data key="d0">Dataset</data>
      <data key="d1">Corpus formed by the augmented examples for training the generator.</data>
      <data key="d2">3</data>
    </node>
    <node id="Corpus D_gen">
      <data key="d0">Dataset</data>
      <data key="d1">生成器所使用的語料庫。</data>
      <data key="d2">3</data>
    </node>
    <node id="Retrieved Passages">
      <data key="d0">Dataset</data>
      <data key="d1">被包在 &lt;p&gt; 與 &lt;/p&gt; 之間並從損失中遮罩的檢索段落。</data>
      <data key="d2">3</data>
    </node>
    <node id="Critic">
      <data key="d0">Model</data>
      <data key="d1">推理時不需要的評論模型。</data>
      <data key="d2">13</data>
    </node>
    <node id="Retrieve=Yes">
      <data key="d0">Hyperparameter</data>
      <data key="d1">其正規化機率超過閾值 delta 時會觸發檢索。</data>
      <data key="d2">14</data>
    </node>
    <node id="Threshold Delta">
      <data key="d0">Hyperparameter</data>
      <data key="d1">決定是否觸發檢索的閾值。</data>
      <data key="d2">15</data>
    </node>
    <node id="Tree Decoding">
      <data key="d0">Method</data>
      <data key="d1">在每個片段步驟中平行處理 K 個檢索段落並產生候選的解碼方法。</data>
      <data key="d2">3</data>
    </node>
    <node id="Segment-Level Beam Search">
      <data key="d0">Method</data>
      <data key="d1">使用束寬 B 來保留最佳續寫的片段級束搜索。</data>
      <data key="d2">3</data>
    </node>
    <node id="Critic Score S">
      <data key="d0">Metric</data>
      <data key="d1">每個片段透過生成機率加上加權線性和計算出的評論分數。</data>
      <data key="d2">3</data>
    </node>
