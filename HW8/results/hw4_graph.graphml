      <data key="d0">Component</data>
      <data key="d1">用於控制證據支持度的權重或標籤</data>
      <data key="d2">4</data>
    </node>
    <node id="isuse">
      <data key="d0">Component</data>
      <data key="d1">用於推理時控制使用程度的權重</data>
      <data key="d2">16</data>
    </node>
